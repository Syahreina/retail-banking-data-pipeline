    <DTS:Executable
      DTS:refId="Package\Load Account Dimension"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1B02A159-270C-403B-AA09-1D160BEAFDC9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Account Dimension"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{DCC2CF11-0F9F-4E92-88EA-1D6F2FD73CC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.dim_account (&#xA;    account_id,&#xA;    customer_key,&#xA;    account_type,&#xA;    opening_date,&#xA;    [status]&#xA;)&#xA;SELECT&#xA;    LTRIM(RTRIM(stg.accounts.account_id)),&#xA;    dw.dim_customer.customer_key,&#xA;    UPPER(LTRIM(RTRIM(stg.accounts.account_type))),&#xA;    TRY_CONVERT(&#xA;        DATE,&#xA;        LTRIM(RTRIM(REPLACE(stg.accounts.opening_date, CHAR(13), ''))),&#xA;        23&#xA;    ),&#xA;    UPPER(&#xA;        LTRIM(&#xA;            RTRIM(&#xA;                REPLACE(stg.accounts.[status], CHAR(13), '')&#xA;            )&#xA;        )&#xA;    )&#xA;FROM stg.accounts&#xA;LEFT JOIN dw.dim_customer&#xA;    ON LTRIM(RTRIM(stg.accounts.customer_id))&#xA;       = dw.dim_customer.customer_id&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM dw.dim_account&#xA;    WHERE dw.dim_account.account_id&#xA;          = LTRIM(RTRIM(stg.accounts.account_id))&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
